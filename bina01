export const getUploadInfo =
async (req, res) => {

    try{

        const filePath =
            path.join(

                process.cwd(),

                "uploads",

                req.params.filename

            );

        if(

            !fs.existsSync(filePath)

        ){

            return res.status(404).json({

                success: false,

                message:
                    "File not found."

            });

        }

        const stat =
            fs.statSync(filePath);

        return res.json({

            success: true,

            file: {

                filename:
                    req.params.filename,

                size:
                    stat.size,

                created:
                    stat.birthtime,

                modified:
                    stat.mtime

            }

        });

    }

    catch(error){

        return res.status(500).json({

            success: false,

            message:
                error.message

        });

    }

};

