/*==========================================
  REPLACE FILE
==========================================*/

export const replaceUpload =
async (req, res) => {

    try{

        if(!req.file){

            return res.status(400).json({

                success: false,

                message:
                    "No replacement file uploaded."

            });

        }

        const oldFile =
            path.join(

                process.cwd(),

                "uploads",

                req.params.filename

            );

        if(

            fs.existsSync(oldFile)

        ){

            fs.unlinkSync(

                oldFile

            );

        }

        return res.json({

            success: true,

            message:
                "File replaced successfully.",

            file:{

                filename:
                    req.file.filename,

                original:
                    req.file.originalname,

                size:
                    req.file.size,

                type:
                    req.file.mimetype,

                path:
                    req.file.path

            }

        });

    }

    catch(error){

        return res.status(500).json({

            success:false,

            message:
                error.message

        });

    }

};

/*==========================================
  CLEAR ALL UPLOADS
==========================================*/

export const clearUploads =
async (req, res) => {

    try{

        const folder =
            path.join(

                process.cwd(),

                "uploads"

            );

        if(

            !fs.existsSync(folder)

        ){

            return res.json({

                success:true,

                deleted:0

            });

        }

        const files =
            fs.readdirSync(folder);

        files.forEach(file=>{

            fs.unlinkSync(

                path.join(

                    folder,

                    file

                )

            );

        });

        return res.json({

            success:true,

            deleted:
                files.length,

            message:
                "Uploads folder cleared."

        });

    }

    catch(error){

        return res.status(500).json({

            success:false,

            message:
                error.message

        });

    }

};

/*==========================================
  STORAGE STATISTICS
==========================================*/

export const storageStats =
async (req, res) => {

    try{

        const folder =
            path.join(

                process.cwd(),

                "uploads"

            );

        if(

            !fs.existsSync(folder)

        ){

            return res.json({

                success:true,

                stats:{

                    files:0,

                    size:0

                }

            });

        }

        const files =
            fs.readdirSync(folder);

        let totalSize = 0;

        files.forEach(file=>{

            const stat =
                fs.statSync(

                    path.join(

                        folder,

                        file

                    )

                );

            totalSize += stat.size;

        });

        return res.json({

            success:true,

            stats:{

                files:
                    files.length,

                size:
                    totalSize,

                sizeMB:
                    (

                        totalSize /

                        1024 /

                        1024

                    ).toFixed(2)

            }

        });

    }

    catch(error){

        return res.status(500).json({

            success:false,

            message:
                error.message

        });

    }

};

/*==========================================
  EXPORT UPLOAD REPORT
==========================================*/

export const exportUploads =
async (req, res) => {

    try{

        const folder =
            path.join(

                process.cwd(),

                "uploads"

            );

        if(

            !fs.existsSync(folder)

        ){

            return res.json({

                success:true,

                exported:0,

                uploads:[]

            });

        }

        const uploads =
            fs.readdirSync(folder)

            .map(file=>{

                const stat =
                    fs.statSync(

                        path.join(

                            folder,

                            file

                        )

                    );

                return{

                    filename:file,

                    size:stat.size,

                    created:stat.birthtime,

                    modified:stat.mtime

                };

            });

        return res.json({

            success:true,

            exported:
                uploads.length,

            uploads

        });

    }

    catch(error){

        return res.status(500).json({

            success:false,

            message:
                error.message

        });

    }

};

