<script>

/* =========================
ENGINE
========================= */

const ENGINE = {

maxVirtualChannels:100000,
renderLimit:250,
performanceMode:true

};

/* =========================
PLAYLISTS
========================= */

const playlists = [

"https://iptv-org.github.io/iptv/index.m3u",
"https://raw.githubusercontent.com/Free-TV/IPTV/master/playlist.m3u8",
"https://raw.githubusercontent.com/freecasthub/public-iptv/main/playlist.m3u",
"https://raw.githubusercontent.com/BuddyChewChew/app-m3u-generator/main/playlists/roku_all.m3u"

];

/* =========================
STREAMS
========================= */

const streams = [

"https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8",
"https://test-streams.mux.dev/test_001/stream.m3u8",
"https://test-streams.mux.dev/test_002/stream.m3u8"

];

/* =========================
GLOBAL STATE
========================= */

let channels = [];
let filteredChannels = [];
let currentIndex = 0;
let currentPage = 0;
let autoPlay = true;
let dark = true;
let currentHls = null;

/* =========================
CATEGORIES
========================= */

const categories = [

"SPORTS",
"MOVIES",
"NEWS",
"KIDS",
"MUSIC",
"VIP"

];

/* =========================
LOAD PLAYLISTS
========================= */

async function loadPlaylists(){

channels = [];

const seen = new Set();

for(const url of playlists){

try{

const res = await fetch(url);
const text = await res.text();

const parsed = parseM3U(text);

parsed.forEach(ch=>{

if(ch.url && !seen.has(ch.url)){

seen.add(ch.url);

channels.push({

id:channels.length+1,
name:ch.name || "Unknown",
category:(ch.group || "LIVE").toUpperCase(),
type:Math.random()>0.7 ? "paid" : "free",
live:true,
viewers:Math.floor(Math.random()*1000000),
logo:ch.logo || "https://via.placeholder.com/60",
url:ch.url

});

}

});

}catch(err){

console.log("FAILED:",url);

}

}

/* =========================
GENERATE CHANNELS
========================= */

for(let i=1;i<=ENGINE.maxVirtualChannels;i++){

const cat =
categories[
i % categories.length
];

channels.push({

id:channels.length+1,

name:
"BTECH "+cat+
" LIVE "+i,

category:cat,

type:
i % 3===0
? "paid"
: "free",

live:
Math.random()>0.08,

viewers:
Math.floor(
Math.random()*1000000
),

logo:
"https://via.placeholder.com/60",

url:
streams[
i % streams.length
]

});

}

filteredChannels = [...channels];

updateStats();

renderChannels();

document.getElementById(
"overlay"
).style.display="none";

}

/* =========================
PARSE M3U
========================= */

function parseM3U(text){

const lines = text.split("\n");

const result = [];

let temp = {};

for(let line of lines){

line = line.trim();

if(line.startsWith("#EXTINF")){

temp = {

name:
line.match(/,(.*)/)?.[1]
|| "Unknown",

logo:
line.match(/tvg-logo="(.*?)"/)?.[1]
|| "",

group:
line.match(/group-title="(.*?)"/)?.[1]
|| "LIVE"

};

}

else if(line.startsWith("http")){

temp.url = line;

result.push(temp);

temp = {};

}

}

return result;

}

/* =========================
STATS
========================= */

function updateStats(){

document.getElementById(
"total"
).innerText =
channels.length.toLocaleString();

document.getElementById(
"free"
).innerText =
channels.filter(
c=>c.type==="free"
).length.toLocaleString();

document.getElementById(
"premium"
).innerText =
channels.filter(
c=>c.type==="paid"
).length.toLocaleString();

document.getElementById(
"live"
).innerText =
channels.filter(
c=>c.live
).length.toLocaleString();

}

/* =========================
RENDER
========================= */

function renderChannels(reset=true){

const box =
document.getElementById(
"channelList"
);

if(reset){

box.innerHTML="";
currentPage=0;

}

const start =
currentPage *
ENGINE.renderLimit;

const end =
start +
ENGINE.renderLimit;

filteredChannels
.slice(start,end)
.forEach((c,index)=>{

const div =
document.createElement("div");

div.className="channel";

div.innerHTML=`

<div class="channel-left">

<img
src="${c.logo}"
loading="lazy"
>

<div class="channel-info">

<h4>
${c.live ? "🔴" : "⚫"}
${c.name}
</h4>

<small>
${c.category}
•
👥 ${c.viewers.toLocaleString()}
</small>

</div>

</div>

<div class="channel-right">

<span class="
badge
${c.type==='free'
?'free'
:'vip'}
">
${c.type}
</span>

<span class="
badge
${c.live
?'live'
:'offline'}
">
${c.live
?'LIVE'
:'OFFLINE'}
</span>

</div>

`;

div.onclick =
()=>playChannel(
start+index,
div
);

box.appendChild(div);

});

}

/* =========================
PLAY CHANNEL
========================= */

function playChannel(index,el=null){

currentIndex=index;

const channel=
filteredChannels[index];

document.getElementById(
"channelName"
).innerText=
channel.name;

document.getElementById(
"channelCategory"
).innerText=
channel.category;

const video=
document.getElementById(
"videoPlayer"
);

if(currentHls){

currentHls.destroy();

}

if(Hls.isSupported()){

currentHls=
new Hls({

enableWorker:true,
lowLatencyMode:true

});

currentHls.loadSource(
channel.url
);

currentHls.attachMedia(video);

currentHls.on(
Hls.Events.MANIFEST_PARSED,
()=>{

if(autoPlay){

video.play();

}

}
);

}else{

video.src=
channel.url;

if(autoPlay){

video.play();

}

}

document
.querySelectorAll(".channel")
.forEach(c=>{

c.classList.remove(
"active"
);

});

if(el){

el.classList.add(
"active"
);

}

}

/* =========================
NEXT / PREV
========================= */

function nextChannel(){

currentIndex++;

if(
currentIndex >=
filteredChannels.length
){

currentIndex=0;

}

playChannel(currentIndex);

}

function prevChannel(){

currentIndex--;

if(currentIndex < 0){

currentIndex=
filteredChannels.length-1;

}

playChannel(currentIndex);

}

/* =========================
FILTERS
========================= */

function filterCategory(cat,event){

document
.querySelectorAll(".menu-item")
.forEach(el=>{

el.classList.remove(
"active"
);

});

if(event){

event.target.classList.add(
"active"
);

}

if(cat==="ALL"){

filteredChannels=[...channels];

}else{

filteredChannels=
channels.filter(c=>

c.category
.toUpperCase()
.includes(cat)

);

}

renderChannels();

}

function showPremium(){

filteredChannels=
channels.filter(
c=>c.type==="paid"
);

renderChannels();

}

function showLiveOnly(){

filteredChannels=
channels.filter(
c=>c.live
);

renderChannels();

}

function showOffline(){

filteredChannels=
channels.filter(
c=>!c.live
);

renderChannels();

}

/* =========================
SEARCH
========================= */

function searchChannels(q){

const value=
q.toLowerCase();

filteredChannels=
channels.filter(c=>

c.name
.toLowerCase()
.includes(value)

||

c.category
.toLowerCase()
.includes(value)

);

renderChannels();

}

/* =========================
THEME
========================= */

function toggleTheme(){

dark=!dark;

document.documentElement
.style.setProperty(
"--bg",
dark
?"#0b0f1a"
:"#f1f5f9"
);

document.documentElement
.style.setProperty(
"--panel",
dark
?"#11182a"
:"#ffffff"
);

document.documentElement
.style.setProperty(
"--card",
dark
?"#1b2438"
:"#e2e8f0"
);

document.documentElement
.style.setProperty(
"--text",
dark
?"#ffffff"
:"#000000"
);

}

/* =========================
OPTIMIZATION
========================= */

function optimizeEngine(){

ENGINE.renderLimit = 150;

alert(
"⚡ IPTV Engine Optimized Successfully"
);

}

/* =========================
LIVE IPTV MONITOR
========================= */

setInterval(()=>{

document.getElementById(
"signalStrength"
).innerText =
Math.floor(
85 + Math.random()*15
) + "%";

document.getElementById(
"latency"
).innerText =
Math.floor(
10 + Math.random()*20
) + "ms";

for(let i=0;i<500;i++){

const random=
Math.floor(
Math.random()*channels.length
);

if(channels[random]){

channels[random].viewers=
Math.floor(
Math.random()*1000000
);

channels[random].live=
Math.random()>0.08;

}

}

},5000);

/* =========================
INFINITE SCROLL
========================= */

document
.getElementById(
"channelList"
)
.addEventListener(
"scroll",
function(){

if(

this.scrollTop+
this.clientHeight
>=
this.scrollHeight-100

){

if(

(currentPage+1)*
ENGINE.renderLimit
<
filteredChannels.length

){

currentPage++;

renderChannels(false);

}

}

}
);

/* =========================
START ENGINE
========================= */

loadPlaylists();

</script>

