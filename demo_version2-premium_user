}

@keyframes pulse{
0%{opacity:.6;}
50%{opacity:1;}
100%{opacity:.6;}
}

/* =========================
MOBILE
========================= */

@media(max-width:1000px){

.sidebar{
display:none;
}

.right-panel{
display:none;
}

.channels{
grid-template-columns:1fr;
}

.player{
height:250px;
}

}

</style>

