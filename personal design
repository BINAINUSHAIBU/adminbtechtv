// Load IPTV M3U Playlist
// BTECH-TV WORLD PRO MAX
// ======================================================

const fs = require("fs");
const path = require("path");

router.get(

    "/playlist",

    auth,

    async (req, res) => {

        try {

            // Premium users get full playlist
            // Free users get free playlist

            const playlistFile = req.user.premium

                ? "premium_playlist.m3u"

                : "free_playlist.m3u";

            const playlistPath = path.join(

                __dirname,

                "..",

                "playlists",

                playlistFile

            );

            if (!fs.existsSync(playlistPath)) {

                return res.status(404).json({

                    success: false,

                    message: "Playlist file not found."

                });

            }

            res.setHeader(

                "Content-Type",

                "audio/x-mpegurl"

            );

            res.setHeader(

                "Content-Disposition",

                `inline; filename="${playlistFile}"`

            );

            fs.createReadStream(

                playlistPath

            ).pipe(res);

        }

        catch (error) {

            console.error(error);

            res.status(500).json({

                success: false,

                message: "Unable to load playlist."

            });

        }

    }

);
