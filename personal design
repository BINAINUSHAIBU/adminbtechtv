// ======================================================
// POST /api/player/favorites
// Add Channel to User Favorites
// BTECH-TV WORLD PRO MAX
// ======================================================

router.post(

    "/favorites",

    auth,

    async (req, res) => {

        try {

            const {

                channelId

            } = req.body;

            if (!channelId) {

                return res.status(400).json({

                    success: false,

                    message: "Channel ID is required."

                });

            }

            // ==================================================
            // Replace with MongoDB Models in Production
            // ==================================================

            const channels = [

                {
                    id: 1,
                    name: "BTECH News",
                    premium: false
                },

                {
                    id: 2,
                    name: "BTECH Sports",
                    premium: true
                },

                {
                    id: 3,
                    name: "Movie World",
                    premium: true
                },

                {
                    id: 4,
                    name: "Kids Planet",
                    premium: false
                }

            ];

            const channel = channels.find(

                item => item.id == channelId

            );

            if (!channel) {

                return res.status(404).json({

                    success: false,

                    message: "Channel not found."

                });

            }

            // Free users cannot favorite premium channels

            if (

                channel.premium &&

                !req.user.premium

            ) {

                return res.status(403).json({

                    success: false,

                    message:
                    "Premium subscription required.",

                    upgrade: true

                });

            }

            // Sample favorite object
            // Save to MongoDB in production

            const favorite = {

                id: Date.now(),

                userId: req.user.id,

                channelId: channel.id,

                channelName: channel.name,

                addedAt: new Date()

            };

            res.status(201).json({

                success: true,

                message:

                "Channel added to favorites.",

                favorite

            });

        }

        catch (error) {

            console.error(error);

            res.status(500).json({

                success: false,

                message:

                "Unable to add favorite."

            });

        }

    }

);
