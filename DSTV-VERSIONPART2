
<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>BTECH TV PRO MAX IPTV</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

<script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
<script src="https://js.paystack.co/v1/inline.js"></script>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Poppins,sans-serif;
}

body{

background:#050816;
color:white;
overflow:hidden;

}

:root{

--sidebar:#0f1728;
--card:#10192f;
--accent:#ff2e63;
--green:#28d17c;

}

#app{

display:flex;
height:100vh;

}

/* SIDEBAR */

.sidebar{

width:260px;
background:var(--sidebar);
display:flex;
flex-direction:column;
padding:20px;

}

.logo{

font-size:28px;
font-weight:bold;
color:#ff2e63;
margin-bottom:30px;

}

.menu{

display:flex;
flex-direction:column;
gap:8px;

}

.menu button{

background:none;
border:none;
color:white;
padding:15px;
text-align:left;
cursor:pointer;
border-radius:10px;
transition:.3s;

}

.menu button:hover{

background:#182746;

}

.main{

flex:1;
display:flex;
flex-direction:column;

}

/* HEADER */

.header{

height:70px;
background:#08101f;
display:flex;
align-items:center;
justify-content:space-between;
padding:15px;

}

.search{

width:400px;
padding:12px;
border:none;
outline:none;
border-radius:40px;

}

.topbuttons button{

padding:10px 20px;
margin-left:10px;
border:none;
border-radius:20px;
cursor:pointer;

}

.hero{

height:230px;
margin:20px;
border-radius:20px;
background:linear-gradient(90deg,#ff2e63,#6d28d9);
display:flex;
justify-content:center;
align-items:center;
font-size:40px;
font-weight:bold;

}

.content{

display:flex;
flex:1;
overflow:hidden;

}

.channels{

width:350px;
background:#111a31;
overflow:auto;

}

.channel{

display:flex;
align-items:center;
padding:12px;
cursor:pointer;
border-bottom:1px solid #1d2945;

}

.channel:hover{

background:#1d2945;

}

.channel img{

width:55px;
height:55px;
border-radius:10px;
margin-right:15px;

}

.player{

flex:1;
display:flex;
flex-direction:column;
padding:20px;

}

video{

width:100%;
height:70vh;
background:black;
border-radius:20px;

}

.bottom{

display:flex;
margin-top:20px;
gap:15px;

}

.card{

background:#111a31;
padding:20px;
border-radius:15px;
flex:1;

}

.category{

display:inline-block;
padding:8px 18px;
background:#182746;
margin:5px;
border-radius:20px;
cursor:pointer;

}

.modal{

display:none;
position:fixed;
left:0;
top:0;
width:100%;
height:100%;
background:rgba(0,0,0,.8);
justify-content:center;
align-items:center;

}

.modal-content{

background:#111a31;
padding:30px;
border-radius:15px;
width:400px;

}

.modal input{

width:100%;
padding:12px;
margin:10px 0;

}

.modal button{

padding:12px;
width:100%;

}

@media(max-width:900px){

.sidebar{

display:none;

}

.channels{

display:none;

}

.search{

width:200px;

}

.hero{

font-size:25px;

}

}

</style>

</head>

<body>

<div id="app">

<div class="sidebar">

<div class="logo">

📺 BTECH TV

</div>

<div class="menu">

<button>🏠 Home</button>

<button>📺 Live TV</button>

<button>🎬 Movies</button>

<button>📺 Series</button>

<button>⚽ Sports</button>

<button>📰 News</button>

<button>👶 Kids</button>

<button>🎵 Music</button>

<button>❤️ Favorites</button>

<button>🕒 Recently Watched</button>

<button onclick="showSettings()">⚙ Settings</button>

</div>

</div>

<div class="main">

<div class="header">

<input
class="search"
id="search"
placeholder="Search Channels">

<div class="topbuttons">

<button onclick="uploadPlaylist()">

Upload M3U

</button>

<button onclick="importURL()">

Import URL

</button>

<button onclick="showLogin()">

Login

</button>

<button onclick="subscribe()">

Subscribe

</button>

</div>

</div>

<div class="hero">

WORLD TV PRO MAX IPTV

</div>

<div class="content">

<div class="channels" id="channelList">

</div>

<div class="player">

<video id="video" controls autoplay></video>

<div class="bottom">

<div class="card">

<h3>Categories</h3>

<div class="category">Sports</div>
<div class="category">Movies</div>
<div class="category">Kids</div>
<div class="category">Entertainment</div>
<div class="category">News</div>
<div class="category">Music</div>

</div>

<div class="card">

<h3>Statistics</h3>

<p>Total Channels</p>

<h2 id="count">

0

</h2>

</div>

</div>

</div>

</div>

</div>

</div>

<div class="modal" id="login">

<div class="modal-content">

<h2>User Login</h2>

<input placeholder="Email">

<input placeholder="Password" type="password">

<button>Login</button>

</div>

</div>

<script>

const channels=[];

function showLogin(){

document.getElementById("login").style.display="flex";

}

window.onclick=e=>{

if(e.target.className=="modal")

e.target.style.display="none";

}

function uploadPlaylist(){

alert("Upload M3U Coming in Part 2");

}

function importURL(){

alert("Import URL Coming in Part 2");

}

function subscribe(){

alert("Paystack Integration Coming in Part 3");

}

function showSettings(){

alert("Settings Coming in Part 4");

}

</script>

</body>
</html>
