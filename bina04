/* ============================================================
   EPG Statistics
============================================================ */

export const epgStats =

async (

    req,

    res

) => {


    try {


        const totalPrograms =

            await EPG.countDocuments();



        const channels =

            await EPG.distinct(

                "channel"

            );



        const upcoming =

            await EPG.countDocuments({

                startTime:

                {

                    $gt:

                        new Date(),

                },

            });



        res.json({

            success:

                true,

            stats:

            {

                totalPrograms,

                channels:

                    channels.length,

                upcoming,

            },

        });


    }

    catch (

        error

    ) {


        res.status(

            500

        )

        .json({

            message:

                error.message,

        });


    }


};




