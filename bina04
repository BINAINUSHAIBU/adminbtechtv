/* ============================================================
   Search EPG Programs
============================================================ */

export const searchEPG =

async (

    req,

    res

) => {


    try {


        const keyword =

            req.query.q;



        const programs =

            await EPG.find({

                title:

                {

                    $regex:

                        keyword,



                    $options:

                        "i",

                },

            })

            .sort({

                startTime:

                    1,

            });



        res.json({

            success:

                true,

            programs,

        });


    }

    catch (

        error

    ) {


        res.status(

            500

        )

        .json({

            message:

                error.message,

        });


    }


};




/* ============================================================
   TV Guide Timeline
============================================================ */

export const tvGuideTimeline =

async (

    req,

    res

) => {


    try {


        const channels =

            await Channel.find({

                status:

                    "active",

            });



        const timeline =

            await Promise.all(

                channels.map(

                    async channel => {


                        const programs =

                            await EPG.find({

                                channel:

                                    channel._id,

                            })

                            .sort({

                                startTime:

                                    1,

                            })

                            .limit(

                                10

                            );



                        return {

                            channel,

                            programs,

                        };


                    }

                )

            );



        res.json({

            success:

                true,

            timeline,

        });


    }

    catch (

        error

    ) {


        res.status(

            500

        )

        .json({

            message:

                error.message,

        });


    }


};




