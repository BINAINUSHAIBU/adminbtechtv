// frontend/admin-dashboard/src/services/authService.js

import api from "./api";





const authService={





    // Admin Login

    login:async(credentials)=>{

        const response=

            await api.post(

                "/auth/login",

                credentials

            );





        if(response.token){

            localStorage.setItem(

                "btech_admin_token",

                response.token

            );

        }





        if(response.user){

            localStorage.setItem(

                "btech_admin_user",

                JSON.stringify(

                    response.user

                )

            );

        }





        return response;

    },





    // Register Admin

    register:async(data)=>{

        return await api.post(

            "/auth/register",

            data

        );

    },





    // Current logged in admin

    getProfile:async()=>{

        return await api.get(

            "/auth/profile"

        );

    },





    // Update profile

    updateProfile:async(data)=>{

        return await api.put(

            "/auth/profile",

            data

        );

    },





    // Change password

    changePassword:async(data)=>{

        return await api.put(

            "/auth/change-password",

            data

        );

    },





    // Logout

    logout:()=>{

        localStorage.removeItem(

            "btech_admin_token"

        );





        localStorage.removeItem(

            "btech_admin_user"

        );





        window.location.href=

            "/login";

    },





    // Check authentication

    isAuthenticated:()=>{

        return Boolean(

            localStorage.getItem(

                "btech_admin_token"

            )

        );

    },





    // Get saved admin user

    getStoredUser:()=>{

        const user=

            localStorage.getItem(

                "btech_admin_user"

            );





        return user

            ?

            JSON.parse(user)

            :

            null;

    }

};





export default authService;

