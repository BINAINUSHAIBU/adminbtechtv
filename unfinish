
<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">

<title>BTECH-TV WORLD PRO MAX</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Poppins,sans-serif;
}

body{
background:#040812;
color:white;
overflow:hidden;
display:flex;
height:100vh;
}

/* Sidebar */

.sidebar{
width:270px;
background:#091324;
padding:20px;
overflow:auto;
border-right:1px solid #173458;
}

.logo{
font-size:24px;
font-weight:bold;
color:#00d4ff;
margin-bottom:20px;
}

.menu-title{
margin:20px 0 10px;
font-size:13px;
color:#00d4ff;
text-transform:uppercase;
}

.menu button{
width:100%;
padding:12px;
margin-bottom:8px;
background:#12213d;
border:none;
border-radius:8px;
color:white;
cursor:pointer;
transition:.3s;
}

.menu button:hover{
background:#00d4ff;
color:#000;
}

/* Main */

.main{
flex:1;
display:flex;
flex-direction:column;
padding:20px;
overflow:hidden;
}

/* Top */

.top{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:20px;
}

.search{
width:320px;
padding:12px;
background:#111f39;
border:none;
border-radius:8px;
color:white;
}

.live{
background:red;
padding:8px 15px;
border-radius:30px;
font-weight:bold;
}

/* Hero */

.hero{
background:linear-gradient(135deg,#0c1833,#152f5d);
padding:20px;
border-radius:15px;
margin-bottom:20px;
}

.hero h2{
margin-bottom:8px;
}

.stats{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:15px;
margin-top:15px;
}

.stat{
background:#111f39;
padding:15px;
border-radius:10px;
text-align:center;
}

.stat h1{
font-size:30px;
color:#00d4ff;
}

/* Player */

.player{
height:340px;
background:black;
border-radius:12px;
display:flex;
align-items:center;
justify-content:center;
font-size:30px;
margin-bottom:20px;
}

/* Controls */

.controls{
display:flex;
gap:10px;
margin-bottom:20px;
flex-wrap:wrap;
}

.controls button{
padding:10px 15px;
background:#12213d;
border:none;
color:white;
border-radius:6px;
cursor:pointer;
}

.controls button:hover{
background:#00d4ff;
color:black;
}

/* Channels */

.channels{
display:grid;
grid-template-columns:repeat(auto-fill,minmax(220px,1fr));
gap:15px;
overflow:auto;
padding-bottom:20px;
}

.channel{
background:#111f39;
border-radius:12px;
padding:15px;
cursor:pointer;
transition:.3s;
}

.channel:hover{
transform:translateY(-5px);
border:1px solid #00d4ff;
}

.channel h4{
color:#00d4ff;
margin-bottom:10px;
}

.badge{
float:right;
background:red;
padding:4px 8px;
border-radius:20px;
font-size:10px;
}

@media(max-width:900px){

body{
flex-direction:column;
}

.sidebar{
width:100%;
height:220px;
}

}

</style>

</head>

<body>

<div class="sidebar">

<div class="logo">
📺 BTECH-TV WORLD PRO MAX
</div>

<div class="menu">

