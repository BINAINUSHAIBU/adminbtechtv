      <!-- FOOTER -->
      <footer>
        <div>12,000 Channel Package • 30-Day Validity</div>

        <div>
          Design by
          <strong>BINAINU SHAIBU</strong>
          |
          <strong>BTECH WEBSITE DESIGN</strong>
        </div>
      </footer>
    </main>

    <!-- ACTIVATION MODAL -->
    <div class="modal" id="activationModal" aria-hidden="true">
      <div class="modal-box">
        <div class="modal-head">
          <div>
            <h2>12,000 Channel Package</h2>

            <p>$124.99 / month</p>
          </div>

          <button
            class="close-btn"
            id="closeActivation"
            type="button"
            aria-label="Close"
          >
            ×
          </button>
        </div>

        <form id="activationForm">
          <div class="form-group">
            <label for="fullName"> Full Name </label>

            <input
              id="fullName"
              name="fullName"
              type="text"
              placeholder="Enter your full name"
              autocomplete="name"
              required
            />
          </div>

          <div class="form-group">
            <label for="email"> Email Address </label>

            <input
              id="email"
              name="email"
              type="email"
              placeholder="Enter your email address"
              autocomplete="email"
              required
            />
          </div>

          <div class="form-group">
            <label for="phone"> Phone Number </label>

            <input
              id="phone"
              name="phone"
              type="tel"
              placeholder="Enter your phone number"
              autocomplete="tel"
              required
            />
          </div>

          <div class="form-group">
            <label for="paymentType"> Payment Type </label>

            <select id="paymentType" name="paymentType" required>
              <option value="">Select payment method</option>

              <option value="Paystack">Paystack</option>

              <option value="Moniepoint">Moniepoint</option>

              <option value="PayPal">PayPal</option>

              <option value="Paypad">Paypad</option>
            </select>
          </div>

          <button class="submit-btn" type="submit">
            Confirm 12,000 Channel Activation
          </button>
        </form>

        <div class="success-box" id="successBox">
          <div class="success-icon">✓</div>

          <h3>Activation Successful</h3>

          <p>
            Your 12,000-channel package has been activated successfully for 30
            days.
          </p>

          <p>Returning to the BTECH-TV WORLD PRO MAX dashboard...</p>
        </div>
      </div>
    </div>

    <script>
      "use strict";

      const PACKAGE = Object.freeze({
        id: "12000",
        name: "12,000 Channel Package",
        channels: 12000,
        price: 124.99,
        currency: "USD",
        validityDays: 30,
      });

      window.BTECH_PACKAGE = PACKAGE;

      const STORAGE = Object.freeze({
        subscription: "btech_tv_subscription",
        premium: "btech_tv_premium",
        package: "btech_tv_package",
        channelLimit: "btech_tv_channel_limit",
        expires: "btech_tv_package_expires",
      });

      const modal = document.getElementById("activationModal");

      const openButton = document.getElementById("openActivation");

      const closeButton = document.getElementById("closeActivation");

      const form = document.getElementById("activationForm");

      const successBox = document.getElementById("successBox");

      function openModal() {
        modal.classList.add("show");
        modal.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";

        setTimeout(() => {
          document.getElementById("fullName")?.focus();
        }, 50);
      }

      function closeModal() {
        modal.classList.remove("show");
        modal.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
      }

      function clearExpiredSubscription() {
        const expiresAt = Number(localStorage.getItem(STORAGE.expires) || 0);

        if (expiresAt && Date.now() >= expiresAt) {
          localStorage.removeItem(STORAGE.subscription);

          localStorage.removeItem(STORAGE.premium);

          localStorage.removeItem(STORAGE.package);

          localStorage.removeItem(STORAGE.channelLimit);

          localStorage.removeItem(STORAGE.expires);
        }
      }

      function activatePackage(data) {
        const activatedAt = Date.now();

        const expiresAt =
          activatedAt + PACKAGE.validityDays * 24 * 60 * 60 * 1000;

        const subscription = {
          packageId: PACKAGE.id,
          packageName: PACKAGE.name,
          channels: PACKAGE.channels,
          price: PACKAGE.price,
          currency: PACKAGE.currency,
          validityDays: PACKAGE.validityDays,
          fullName: data.fullName,
          email: data.email,
          phone: data.phone,
          paymentType: data.paymentType,
          activatedAt,
          expiresAt,
          status: "active",
        };

        localStorage.setItem(
          STORAGE.subscription,
          JSON.stringify(subscription),
        );

        localStorage.setItem(STORAGE.premium, "true");

        localStorage.setItem(STORAGE.package, PACKAGE.id);

        localStorage.setItem(STORAGE.channelLimit, String(PACKAGE.channels));

        localStorage.setItem(STORAGE.expires, String(expiresAt));

        return subscription;
      }

      openButton.addEventListener("click", openModal);

      closeButton.addEventListener("click", closeModal);

      modal.addEventListener("click", (event) => {
        if (event.target === modal) {
          closeModal();
        }
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && modal.classList.contains("show")) {
          closeModal();
        }
      });

      form.addEventListener("submit", (event) => {
        event.preventDefault();

        const formData = new FormData(form);

        const data = {
          fullName: String(formData.get("fullName") || "").trim(),

          email: String(formData.get("email") || "").trim(),

          phone: String(formData.get("phone") || "").trim(),

          paymentType: String(formData.get("paymentType") || "").trim(),
        };

        if (!data.fullName || !data.email || !data.phone || !data.paymentType) {
          return;
        }

        activatePackage(data);

        form.style.display = "none";
        successBox.classList.add("show");

        setTimeout(() => {
          window.location.href = "../index.html";
        }, 1600);
      });

      clearExpiredSubscription();
    </script>
  </body>
</html>
