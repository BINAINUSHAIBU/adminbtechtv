      </section>

      <!-- CONTENT -->
      <section class="content-grid">
        <div class="card">
          <h2>Package Features</h2>

          <p class="card-description">
            The 12,000-channel package provides a large channel allowance for
            the BTECH-TV WORLD PRO MAX IPTV dashboard.
          </p>

          <div class="features">
            <div class="feature">
              <div class="feature-icon">📺</div>
              <div class="feature-text">
                12,000 Channels
                <small> Maximum package channel allowance </small>
              </div>
            </div>

            <div class="feature">
              <div class="feature-icon">⚡</div>
              <div class="feature-text">
                Fast IPTV Dashboard
                <small> Designed for efficient channel browsing </small>
              </div>
            </div>

            <div class="feature">
              <div class="feature-icon">🌍</div>
              <div class="feature-text">
                Global Channel Access
                <small> Browse channels from multiple countries </small>
              </div>
            </div>

            <div class="feature">
              <div class="feature-icon">📡</div>
              <div class="feature-text">
                Live Streaming Support
                <small> Compatible with supported IPTV streams </small>
              </div>
            </div>

            <div class="feature">
              <div class="feature-icon">🗓️</div>
              <div class="feature-text">
                30-Day Validity
                <small> Activation validity period </small>
              </div>
            </div>
          </div>
        </div>

        <div class="card">
          <h2>Package Summary</h2>

          <p class="card-description">
            Everything included in this subscription package.
          </p>

          <div class="features">
            <div class="feature">
              <div class="feature-icon">✓</div>
              <div class="feature-text">
                Premium Access
                <small> Premium status enabled after activation </small>
              </div>
            </div>

            <div class="feature">
              <div class="feature-icon">12K</div>
              <div class="feature-text">
                Channel Limit
                <small> 12,000 channels </small>
              </div>
            </div>

            <div class="feature">
              <div class="feature-icon">30</div>
              <div class="feature-text">
                Validity
                <small> 30 days from activation </small>
              </div>
            </div>

            <div class="feature">
              <div class="feature-icon">$</div>
              <div class="feature-text">
                Monthly Price
                <small> $124.99 USD </small>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- STATS -->
      <section class="stats">
        <div class="stat">
          <div class="stat-value">12K</div>
          <div class="stat-label">Channels</div>
        </div>

        <div class="stat">
          <div class="stat-value">30</div>
          <div class="stat-label">Days</div>
        </div>

        <div class="stat">
          <div class="stat-value">$124.99</div>
          <div class="stat-label">Monthly</div>
        </div>

        <div class="stat">
          <div class="stat-value">HD</div>
          <div class="stat-label">Streaming</div>
        </div>
      </section>

      <!-- PAYMENT -->
      <section class="card payment-card">
        <h2>Available Payment Methods</h2>

        <p class="card-description">
          Select your preferred payment type during activation.
        </p>

        <div class="payment-methods">
          <div class="payment-method">
            <span>💳</span>
            Paystack
          </div>

          <div class="payment-method">
            <span>🏦</span>
            Moniepoint
          </div>

          <div class="payment-method">
            <span>🌐</span>
            PayPal
          </div>

          <div class="payment-method">
            <span>💰</span>
            Paypad
          </div>
