<script>

let all=[];
let filtered=[];
let current=0;

const video=document.getElementById("video");

let hls;

async function load(code){
loadM3U(`https://iptv-org.github.io/iptv/countries/${code}.m3u`);
}

async function loadCat(cat){
loadM3U(`https://iptv-org.github.io/iptv/categories/${cat}.m3u`);
}

async function loadUltra(){
loadM3U("https://iptv-org.github.io/iptv/index.country.m3u");
}

async function loadM3U(url){

const res=await fetch(url);
const text=await res.text();

all=[];

text.split("\n").forEach((line,index,array)=>{

if(line.startsWith("#EXTINF")){

const name=line.split(",").pop();
const stream=array[index+1];

if(stream && stream.startsWith("http")){
all.push({
name:name,
url:stream
});
}

}

});

filtered=[...all];

render();
updateStats();
}

function render(){

grid.innerHTML="";

filtered.forEach((channel,index)=>{

const card=document.createElement("div");

card.className="card";

card.innerHTML=
`<span class="badge">LIVE</span>${channel.name}`;

card.onclick=()=>play(index);

grid.appendChild(card);

});

}

function play(index){

current=index;

const stream=filtered[index];

if(hls){
hls.destroy();
}

if(Hls.isSupported()){

hls=new Hls();

hls.loadSource(stream.url);

hls.attachMedia(video);

hls.on(Hls.Events.MANIFEST_PARSED,function(){
video.play();
});

}else{

video.src=stream.url;
video.play();

}

}

function search(q){

filtered=all.filter(ch=>
ch.name.toLowerCase().includes(q.toLowerCase())
);

render();

}

function next(){

current=(current+1)%filtered.length;
play(current);

}

function prev(){

current=(current-1+filtered.length)%filtered.length;
play(current);

}

function toggleMute(){
video.muted=!video.muted;
}

function toggleFullscreen(){

if(video.requestFullscreen){
video.requestFullscreen();
}

}

function speedBoost(){
video.playbackRate=1.25;
}

function togglePiP(){

if(document.pictureInPictureEnabled){
video.requestPictureInPicture();
}

}

function updateStats(){

document.getElementById("total").innerText=all.length;
document.getElementById("liveCount").innerText=all.length;

}

loadUltra();

</script>

