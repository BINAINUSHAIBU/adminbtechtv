
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ULTRA OTT PRODUCTION SYSTEM</title>

<script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>

<style>
body{margin:0;font-family:Arial;background:#0b0f1a;color:white;overflow:hidden}

/* TOPBAR */
.topbar{
display:flex;
justify-content:space-between;
align-items:center;
padding:10px;
background:#111827;
}
.logo{color:#00d4ff;font-weight:bold}

/* BUTTONS */
button{
padding:8px;
margin:2px;
border:none;
border-radius:6px;
background:#1f2937;
color:white;
cursor:pointer;
}

/* LAYOUT */
.container{display:flex;height:calc(100vh - 50px)}

/* SIDEBAR */
.sidebar{
width:220px;
background:#0f172a;
padding:10px;
overflow:auto;
}

.cat{
padding:8px;
margin:5px 0;
background:#1f2937;
border-radius:6px;
cursor:pointer;
}

/* MAIN */
.main{flex:1;display:flex;flex-direction:column}

/* PLAYER */
.player{height:260px;background:black;position:relative}
video{width:100%;height:100%}
.live{position:absolute;top:10px;left:10px;background:red;padding:5px}

/* LIST */
.list{flex:1;overflow:auto;padding:10px}
.item{
padding:10px;
background:#1f2937;
margin-bottom:5px;
border-radius:6px;
cursor:pointer;
display:flex;
justify-content:space-between;
}

/* ADMIN */
.admin{
position:fixed;
inset:0;
background:rgba(0,0,0,.9);
display:none;
padding:20px;
overflow:auto;
}

.box{
background:#111827;
padding:15px;
border-radius:10px;
margin-bottom:10px;
}
</style>
</head>

<body>

<!-- TOPBAR -->
<div class="topbar">
<div class="logo">📺 ULTRA OTT PRO</div>

<div>
<button onclick="loadMovies()">Movies</button>
<button onclick="loadLive()">Live TV</button>
<button onclick="loadSeries()">Series</button>
<button onclick="openAdmin()">Admin</button>
<button onclick="openPay()">Subscribe</button>
</div>
</div>

<!-- MAIN -->
<div class="container">

<div class="sidebar">
<h3>Categories</h3>
<div class="cat" onclick="loadMovies()">🎬 Movies</div>
<div class="cat" onclick="loadSeries()">📺 Series</div>
<div class="cat" onclick="loadLive()">📡 Live TV</div>
<div class="cat" onclick="clearList()">🧹 Clear</div>
</div>

<div class="main">

<div class="player">
<div class="live">LIVE</div>
<video id="video" controls></video>
</div>

<div class="list" id="list"></div>

</div>
</div>

<!-- ADMIN PANEL -->
<div class="admin" id="admin">

<div class="box">
<h2>ADMIN DASHBOARD</h2>
<p id="stats"></p>
<button onclick="closeAdmin()">Close</button>
</div>

<div class="box">
<h3>Add Movie</h3>
<input id="mname" placeholder="Movie Name">
<input id="murl" placeholder="Video URL">
<button onclick="addMovie()">Add</button>
</div>

<div class="box">
<h3>Add Live Channel</h3>
<input id="cname" placeholder="Channel Name">
<input id="curl" placeholder="Stream URL">
<button onclick="addChannel()">Add</button>
</div>

</div>

<script>

let video=document.getElementById("video");

/* SIMULATED DATABASE */
let DB={
movies:[
{name:"Action Movie",url:"https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8"}
],
series:[
{name:"Episode 1",url:"https://test-streams.mux.dev/test_001/stream.m3u8"}
],
live:[
{name:"DSTV Sports",url:"https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8"}
]
};

/* RENDER */
function render(items){
let box=document.getElementById("list");
box.innerHTML="";

items.forEach((i,idx)=>{
let div=document.createElement("div");
div.className="item";
div.innerHTML=`<span>${i.name}</span><span>▶</span>`;
div.onclick=()=>play(i.url);
box.appendChild(div);
});
}

/* PLAY */
function play(url){
if(Hls.isSupported()){
let hls=new Hls();
hls.loadSource(url);
hls.attachMedia(video);
hls.on(Hls.Events.MANIFEST_PARSED,()=>video.play());
}else{
video.src=url;
video.play();
}
}

/* LOAD SYSTEM */
function loadMovies(){render(DB.movies)}
function loadSeries(){render(DB.series)}
function loadLive(){render(DB.live)}

function clearList(){
document.getElementById("list").innerHTML="";
}

/* ADMIN */
function openAdmin(){
document.getElementById("admin").style.display="block";
updateStats();
}

function closeAdmin(){
document.getElementById("admin").style.display="none";
}

function updateStats(){
document.getElementById("stats").innerHTML=
"Movies: "+DB.movies.length+
"<br>Series: "+DB.series.length+
"<br>Live: "+DB.live.length;
}

function addMovie(){
DB.movies.push({
name:document.getElementById("mname").value,
url:document.getElementById("murl").value
});
updateStats();
}

function addChannel(){
DB.live.push({
name:document.getElementById("cname").value,
url:document.getElementById("curl").value
});
updateStats();
}

/* PAYMENT SIMULATION */
function openPay(){
alert("Subscription Activated (SIMULATED PAYSTACK)");
}

</script>

</body>
</html>
