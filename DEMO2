========================= */

function renderChannels(){

const list =
document.getElementById("channelList");

list.innerHTML = "";

filteredChannels
.slice(0,1000)
.forEach((ch,index)=>{

const div =
document.createElement("div");

div.className = "channel";

div.innerHTML = `

<img
