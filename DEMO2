/* =========================
MEGA CHANNEL GENERATOR
========================= */

function generateVirtualChannels(){

const cats = [
"SPORTS",
"MOVIES",
"NEWS",
"KIDS",
"MUSIC",
"DOCUMENTARY",
"ENTERTAINMENT",
"AFRICA",
"USA",
"UK",
"EUROPE",
"ASIA"
];

for(let i=1;i<=100000;i++){

const cat =
cats[i % cats.length];

allChannels.push({

id:i,

name:`${cat} LIVE ${i}`,

group:cat,

logo:"https://via.placeholder.com/50",

url:"https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8"

});

}

}

/* =========================
LOAD REAL IPTV PLAYLISTS
========================= */

async function loadPlaylists(){

const stats =
document.getElementById("stats");

stats.innerHTML =
"Loading 100,000+ IPTV channels...";

const seen = new Set();

for(const url of playlists){

try{

const res = await fetch(url);

const text = await res.text();

const parsed = parseM3U(text);

parsed.forEach(ch=>{

if(
ch.url &&
!seen.has(ch.url)
){

seen.add(ch.url);

allChannels.push(ch);

}

});

stats.innerHTML =
`${allChannels.length.toLocaleString()} channels loaded`;

}catch(err){

console.log("FAILED:",url);

}

}

/* ADD VIRTUAL CHANNELS */

generateVirtualChannels();

filteredChannels = allChannels;

renderChannels();

document.getElementById("overlay")
.innerHTML = `

<h1>🚀</h1>

<p>
${allChannels.length.toLocaleString()}
Channels Ready
</p>

`;

}

