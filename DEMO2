
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>BTECH-TV PRO ULTRA</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>

<style>

:root{
--bg:#0b0f1a;
--panel:#11182a;
--card:#1b2438;
--hover:#2b3a5a;
--accent:#00bfff;
--text:#ffffff;
--muted:#9aa4c0;
}

*{
margin:0;
padding:0;
box-sizing:border-box;
}

body{
font-family:Arial,sans-serif;
background:var(--bg);
color:var(--text);
overflow:hidden;
}

/* TOPBAR */

.topbar{
display:flex;
justify-content:space-between;
align-items:center;
padding:12px 16px;
background:var(--panel);
position:sticky;
top:0;
z-index:100;
border-bottom:1px solid #202b45;
}

.logo{
font-weight:bold;
font-size:18px;
color:var(--accent);
}

.menu{
display:flex;
gap:12px;
flex-wrap:wrap;
}

.menu a{
cursor:pointer;
font-size:13px;
color:white;
text-decoration:none;
padding:6px 10px;
border-radius:5px;
transition:.2s;
}

.menu a:hover{
background:var(--hover);
}

/* LAYOUT */

.container{
display:flex;
height:calc(100vh - 60px);
}

/* SIDEBAR */

.sidebar{
width:320px;
background:var(--panel);
display:flex;
flex-direction:column;
border-right:1px solid #202b45;
}

.sidebarHeader{
padding:12px;
border-bottom:1px solid #202b45;
}

.sidebarHeader h3{
color:var(--accent);
font-size:16px;
margin-bottom:8px;
}

.stats{
font-size:12px;
color:var(--muted);
}

.channelList{
flex:1;
overflow-y:auto;
padding:8px;
}

/* CHANNEL */

.channel{
display:flex;
align-items:center;
gap:10px;
padding:10px;
margin-bottom:6px;
background:var(--card);
border-radius:8px;
cursor:pointer;
transition:.2s;
}

.channel:hover{
background:var(--hover);
}

.channel img{
width:45px;
height:45px;
object-fit:contain;
border-radius:6px;
background:black;
}

.channelInfo{
flex:1;
overflow:hidden;
}

.channelName{
font-size:13px;
font-weight:bold;
white-space:nowrap;
overflow:hidden;
text-overflow:ellipsis;
}

.channelMeta{
font-size:11px;
color:var(--muted);
margin-top:4px;
}

.live{
font-size:10px;
color:#00ff88;
}

/* MAIN */

.main{
flex:1;
display:flex;
flex-direction:column;
}

/* SEARCH */

.search{
padding:10px;
background:var(--panel);
border-bottom:1px solid #202b45;
}

.search input{
width:100%;
padding:12px;
border:none;
outline:none;
border-radius:6px;
background:#1c2740;
color:white;
}

/* PLAYER */

.player{
flex:1;
position:relative;
background:black;
display:flex;
align-items:center;
justify-content:center;
}

video{
width:100%;
height:100%;
object-fit:contain;
background:black;
}

/* OVERLAY */

.overlay{
position:absolute;
inset:0;
background:rgba(0,0,0,.8);
display:flex;
flex-direction:column;
align-items:center;
justify-content:center;
z-index:5;
}

.overlay h1{
font-size:42px;
margin-bottom:10px;
}

.overlay p{
color:var(--muted);
}

/* CONTROLS */

.controls{
height:70px;
background:var(--panel);
display:flex;
justify-content:space-between;
align-items:center;
padding:0 20px;
border-top:1px solid #202b45;
}

.nowPlaying{
overflow:hidden;
}

.nowPlaying h3{
font-size:15px;
white-space:nowrap;
overflow:hidden;
text-overflow:ellipsis;
}

.nowPlaying p{
font-size:12px;
color:var(--muted);
margin-top:4px;
}

.btns{
display:flex;
gap:10px;
}

button{
padding:10px 14px;
background:var(--card);
border:none;
border-radius:6px;
color:white;
cursor:pointer;
transition:.2s;
}

button:hover{
background:var(--hover);
}

/* SETTINGS */

.settings{
position:fixed;
right:12px;
top:70px;
width:260px;
background:var(--panel);
padding:14px;
border-radius:10px;
display:none;
z-index:1000;
border:1px solid #26324f;
}

.settings h4{
margin-bottom:12px;
color:var(--accent);
}

.settings label{
display:block;
margin:10px 0 5px;
font-size:12px;
}

.settings select{
width:100%;
padding:8px;
border:none;
border-radius:5px;
background:#1c2740;
color:white;
}

/* MOBILE */

@media(max-width:800px){

.sidebar{
position:absolute;
z-index:999;
height:100%;
width:100%;
}

.menu{
display:none;
}

}

</style>
</head>

<body>

<!-- TOPBAR -->

<div class="topbar">

<div class="logo">
📺 BTECH-TV PRO ULTRA
</div>

<div class="menu">
<a onclick="toggleSettings()">Settings</a>
<a onclick="filterCategory('ALL')">All</a>
<a onclick="filterCategory('SPORTS')">Sports</a>
<a onclick="filterCategory('MOVIES')">Movies</a>
<a onclick="filterCategory('NEWS')">News</a>
<a onclick="filterCategory('KIDS')">Kids</a>
</div>

</div>

<!-- MAIN LAYOUT -->

<div class="container">

<!-- SIDEBAR -->

<div class="sidebar">

<div class="sidebarHeader">

<h3>LIVE CHANNELS</h3>

<div class="stats" id="stats">
Loading IPTV Sources...
</div>

</div>

<div class="channelList" id="channelList"></div>

</div>

<!-- MAIN -->

<div class="main">

<!-- SEARCH -->

<div class="search">
<input
type="text"
placeholder="Search BTECH-TV channels..."
oninput="searchChannels(this.value)"
>
</div>

<!-- PLAYER -->

<div class="player">

<video
id="videoPlayer"
controls
autoplay
playsinline
></video>

<div class="overlay" id="overlay">
<h1>📡</h1>
<p>Loading IPTV System...</p>
</div>

</div>

<!-- CONTROLS -->

<div class="controls">

<div class="nowPlaying">

<h3 id="channelName">
No Channel Selected
</h3>

<p id="channelGroup">
Live IPTV Streaming
</p>

</div>

<div class="btns">
<button onclick="prevChannel()">◀ Prev</button>
<button onclick="nextChannel()">Next ▶</button>
</div>

</div>

</div>

</div>

<!-- SETTINGS -->

<div class="settings" id="settingsBox">

<h4>System Settings</h4>

<label>Theme</label>

<select onchange="setTheme(this.value)">
<option value="dark">Dark</option>
<option value="blue">Blue</option>
</select>

<label>Auto Play</label>

<select onchange="autoPlay=this.value==='true'">
<option value="true">ON</option>
<option value="false">OFF</option>
</select>

<label>Quality Mode</label>

<select>
<option>Auto</option>
<option>1080p</option>
<option>720p</option>
<option>480p</option>
</select>

</div>

<script>

/* =========================
PLAYLIST SOURCES
========================= */

const playlists = [

"https://iptv-org.github.io/iptv/index.m3u",
"https://raw.githubusercontent.com/Free-TV/IPTV/master/playlist.m3u8",
"https://raw.githubusercontent.com/freecasthub/public-iptv/main/playlist.m3u",
"https://raw.githubusercontent.com/BuddyChewChew/app-m3u-generator/main/playlists/roku_all.m3u"

];

/* =========================
GLOBAL STATE
========================= */

let allChannels = [];
let filteredChannels = [];
let currentIndex = 0;
let hls = null;
let autoPlay = true;

/* =========================
LOAD PLAYLISTS
========================= */

async function loadPlaylists(){

const stats =
document.getElementById("stats");

stats.innerHTML =
"Loading IPTV playlists...";

const seen = new Set();

for(const url of playlists){

try{

const res = await fetch(url);

const text = await res.text();

const parsed = parseM3U(text);

parsed.forEach(ch=>{

if(!seen.has(ch.url)){

seen.add(ch.url);

allChannels.push(ch);

}

});

stats.innerHTML =
`${allChannels.length.toLocaleString()} channels loaded`;

}catch(err){

console.log("FAILED:",url);

}

}

filteredChannels = allChannels;

renderChannels();

document.getElementById("overlay")
.style.display = "none";

}

/* =========================
PARSE M3U
========================= */

function parseM3U(text){

const lines = text.split("\n");

const result = [];

let temp = {};

for(let line of lines){

line = line.trim();

if(line.startsWith("#EXTINF")){

temp = {

name:
line.match(/,(.*)/)?.[1]
|| "Unknown",

logo:
line.match(/tvg-logo="(.*?)"/)?.[1]
|| "",

group:
line.match(/group-title="(.*?)"/)?.[1]
|| "LIVE"

};

}

else if(line.startsWith("http")){

temp.url = line;

result.push(temp);

temp = {};

}

}

return result;

}

/* =========================
RENDER CHANNELS
========================= */

function renderChannels(){

const list =
document.getElementById("channelList");

list.innerHTML = "";

filteredChannels
.slice(0,500)
.forEach((ch,index)=>{

const div =
document.createElement("div");

div.className = "channel";

div.innerHTML = `

<img
src="${ch.logo || 'https://via.placeholder.com/45'}"
loading="lazy"
>

<div class="channelInfo">

<div class="channelName">
${ch.name}
</div>

<div class="channelMeta">
${ch.group}
</div>

</div>

<div class="live">
● LIVE
</div>

`;

div.onclick = ()=>playChannel(index);

list.appendChild(div);

});

}

/* =========================
SEARCH
========================= */

function searchChannels(q){

filteredChannels =
allChannels.filter(ch=>

ch.name.toLowerCase()
.includes(q.toLowerCase())

);

renderChannels();

}

/* =========================
CATEGORY FILTER
========================= */

function filterCategory(cat){

if(cat==="ALL"){

filteredChannels = allChannels;

}else{

filteredChannels =
allChannels.filter(ch=>

ch.group.toUpperCase()
.includes(cat)

);

}

renderChannels();

}

/* =========================
PLAY CHANNEL
========================= */

function playChannel(index){

currentIndex = index;

const channel =
filteredChannels[index];

document.getElementById("channelName")
.innerText = channel.name;

document.getElementById("channelGroup")
.innerText = channel.group;

const video =
document.getElementById("videoPlayer");

if(hls){

hls.destroy();

hls = null;

}

if(Hls.isSupported()){

hls = new Hls();

hls.loadSource(channel.url);

hls.attachMedia(video);

hls.on(
Hls.Events.MANIFEST_PARSED,
()=>{
if(autoPlay) video.play();
}
);

}else{

video.src = channel.url;

if(autoPlay) video.play();

}

}

/* =========================
NEXT / PREV
========================= */

function nextChannel(){

currentIndex++;

if(currentIndex >= filteredChannels.length){

currentIndex = 0;

}

playChannel(currentIndex);

}

function prevChannel(){

currentIndex--;

if(currentIndex < 0){

currentIndex =
filteredChannels.length - 1;

}

playChannel(currentIndex);

}

/* =========================
SETTINGS
========================= */

function toggleSettings(){

const box =
document.getElementById("settingsBox");

box.style.display =
box.style.display==="block"
? "none"
: "block";

}

function setTheme(theme){

if(theme==="blue"){

document.documentElement
.style.setProperty("--bg","#061a33");

}else{

document.documentElement
.style.setProperty("--bg","#0b0f1a");

}

}

/* =========================
INIT
========================= */

loadPlaylists();

</script>
