loading="lazy"
>

<div class="channelInfo">

<div class="channelName">
${ch.name}
</div>

<div class="channelMeta">
${ch.group}
</div>

</div>

<div class="live">
● LIVE
</div>

`;

div.onclick =
()=>playChannel(index);

